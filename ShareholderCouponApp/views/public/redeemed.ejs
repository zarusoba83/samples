<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>クーポン使用完了</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh">
  <div class="container py-4">
    <div class="coupon-card shadow text-center">
      <div class="mb-3">
        <span style="font-size:4rem">✅</span>
      </div>
      <h4 class="text-success">クーポンを使用しました</h4>
      <p class="text-muted">クーポンコード: <strong><code><%= coupon.coupon_code %></code></strong></p>
      <hr>
      <p class="text-muted small">ご利用ありがとうございました。<br><%= coupon.shareholder_name %> 様</p>
    </div>
  </div>
</body>
</html>

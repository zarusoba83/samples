<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>株主優待クーポン</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh">
  <div class="container py-4">
    <div class="coupon-card shadow">
      <div class="text-center mb-3">
        <span class="badge bg-primary fs-6">株主優待</span>
      </div>

      <h5 class="text-center text-muted mb-1"><%= coupon.campaign_name %></h5>

      <% if (coupon.campaign_description) { %>
        <p class="text-center text-muted small mb-3"><%= coupon.campaign_description %></p>
      <% } %>

      <% if (coupon.discount_value) { %>
        <div class="text-center mb-3">
          <div class="coupon-discount">
            <%= coupon.discount_type === 'percent'
              ? coupon.discount_value + '% OFF'
              : '¥' + coupon.discount_value.toLocaleString() + ' OFF' %>
          </div>
        </div>
      <% } %>

      <div class="text-center mb-3">
        <div class="text-muted small mb-1">クーポンコード</div>
        <div class="coupon-code"><%= coupon.coupon_code %></div>
      </div>

      <% if (coupon.valid_until) { %>
        <p class="text-center text-muted small">
          有効期限: <strong><%= coupon.valid_until.substring(0, 10) %></strong>
        </p>
      <% } %>

      <hr>
      <p class="text-muted small text-center">
        <strong><%= coupon.shareholder_name %></strong> 様へのご優待クーポンです
      </p>

      <form method="POST" action="/coupon/<%= token %>/redeem"
            onsubmit="return confirm('このクーポンを使用しますか？一度使用すると取り消せません。')">
        <button type="submit" class="btn btn-primary w-100 btn-lg mt-2">
          クーポンを使用する
        </button>
      </form>
    </div>
  </div>
</body>
</html>

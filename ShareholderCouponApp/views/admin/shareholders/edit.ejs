<%
  title = '株主編集';
  currentPage = 'shareholders';
%>
<%- include('../../partials/admin_header') %>

<div class="d-flex align-items-center mb-3">
  <a href="/admin/shareholders/<%= values.id %>" class="btn btn-sm btn-outline-secondary me-2">
    <i class="bi bi-arrow-left"></i>
  </a>
  <h4 class="mb-0"><i class="bi bi-pencil"></i> 株主編集</h4>
</div>

<div class="card" style="max-width:500px">
  <div class="card-body">
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <form method="POST" action="/admin/shareholders/<%= values.id %>">
      <div class="mb-3">
        <label class="form-label">株主番号 <span class="text-danger">*</span></label>
        <input type="text" name="shareholder_number" class="form-control"
               value="<%= values.shareholder_number %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">氏名 <span class="text-danger">*</span></label>
        <input type="text" name="name" class="form-control" value="<%= values.name %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">メールアドレス</label>
        <input type="email" name="email" class="form-control" value="<%= values.email || '' %>">
      </div>
      <div class="mb-3">
        <label class="form-label">保有株数</label>
        <input type="number" name="shares_count" class="form-control" min="0"
               value="<%= values.shares_count %>">
      </div>
      <button type="submit" class="btn btn-primary">更新する</button>
    </form>
  </div>
</div>

<%- include('../../partials/admin_footer') %>

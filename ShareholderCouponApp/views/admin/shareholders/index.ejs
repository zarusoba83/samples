<%
  title = '株主管理';
  currentPage = 'shareholders';
%>
<%- include('../../partials/admin_header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-people"></i> 株主管理</h4>
  <a href="/admin/shareholders/new" class="btn btn-primary btn-sm">
    <i class="bi bi-person-plus"></i> 株主を登録
  </a>
</div>

<% if (flash) { %>
  <div class="alert alert-<%= flash.type %> alert-dismissible">
    <%= flash.message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<form class="mb-3 d-flex gap-2" method="GET">
  <input type="text" name="search" class="form-control form-control-sm" style="max-width:300px"
         placeholder="氏名・株主番号・メールで検索" value="<%= search %>">
  <button class="btn btn-sm btn-outline-secondary">検索</button>
  <% if (search) { %><a href="/admin/shareholders" class="btn btn-sm btn-outline-danger">クリア</a><% } %>
</form>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>株主番号</th>
          <th>氏名</th>
          <th>メール</th>
          <th>保有株数</th>
          <th>クーポン数</th>
          <th>登録日</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (rows.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-3">株主が登録されていません</td></tr>
        <% } %>
        <% rows.forEach(s => { %>
          <tr>
            <td><code><%= s.shareholder_number %></code></td>
            <td><%= s.name %></td>
            <td><small><%= s.email || '-' %></small></td>
            <td><%= s.shares_count.toLocaleString() %></td>
            <td><span class="badge bg-secondary"><%= s.coupon_count %></span></td>
            <td><small><%= s.created_at.substring(0, 10) %></small></td>
            <td>
              <a href="/admin/shareholders/<%= s.id %>" class="btn btn-xs btn-outline-primary btn-sm">詳細</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-2 text-muted small">全 <%= total %> 件</div>

<%- include('../../partials/admin_footer') %>

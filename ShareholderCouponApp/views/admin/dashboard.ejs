<%
  title = 'ダッシュボード';
  currentPage = 'dashboard';
%>
<%- include('../partials/admin_header') %>

<h4 class="mb-4"><i class="bi bi-speedometer2"></i> ダッシュボード</h4>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="stat-card bg-primary text-white">
      <div class="stat-value"><%= shareholderCount %></div>
      <div>株主数</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card bg-success text-white">
      <div class="stat-value"><%= couponStats.total || 0 %></div>
      <div>総クーポン数</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card bg-warning">
      <div class="stat-value"><%= couponStats.unused || 0 %></div>
      <div>未使用</div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card bg-secondary text-white">
      <div class="stat-value"><%= couponStats.used || 0 %></div>
      <div>使用済み</div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><i class="bi bi-clock-history"></i> 最近の使用履歴</div>
      <div class="card-body p-0">
        <% if (recentCoupons.length === 0) { %>
          <p class="text-muted p-3 mb-0">まだ使用されたクーポンはありません</p>
        <% } else { %>
          <table class="table table-sm mb-0">
            <thead><tr><th>株主名</th><th>クーポンコード</th><th>使用日時</th></tr></thead>
            <tbody>
              <% recentCoupons.forEach(c => { %>
                <tr>
                  <td><%= c.shareholder_name %></td>
                  <td><code><%= c.coupon_code %></code></td>
                  <td><small><%= c.used_at %></small></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-header"><i class="bi bi-lightning"></i> クイックアクション</div>
      <div class="card-body">
        <a href="/admin/shareholders/new" class="btn btn-outline-primary mb-2 w-100">
          <i class="bi bi-person-plus"></i> 株主を登録する
        </a>
        <a href="/admin/campaigns/new" class="btn btn-outline-success mb-2 w-100">
          <i class="bi bi-plus-circle"></i> キャンペーンを作成する
        </a>
        <a href="/admin/coupons" class="btn btn-outline-secondary w-100">
          <i class="bi bi-ticket-perforated"></i> クーポン一覧を見る
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/admin_footer') %>

<%
  title = coupon.coupon_code;
  currentPage = 'coupons';
%>
<%- include('../../partials/admin_header') %>

<div class="d-flex align-items-center mb-3">
  <a href="/admin/coupons" class="btn btn-sm btn-outline-secondary me-2">
    <i class="bi bi-arrow-left"></i>
  </a>
  <h4 class="mb-0"><i class="bi bi-ticket-perforated"></i> クーポン詳細</h4>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">クーポン情報</div>
      <div class="card-body">
        <dl class="row">
          <dt class="col-5">クーポンコード</dt>
          <dd class="col-7"><code class="fs-5"><%= coupon.coupon_code %></code></dd>
          <dt class="col-5">ステータス</dt>
          <dd class="col-7">
            <% if (effectiveStatus === 'unused') { %>
              <span class="badge badge-unused fs-6">未使用</span>
            <% } else if (effectiveStatus === 'used') { %>
              <span class="badge badge-used fs-6">使用済み</span>
            <% } else if (effectiveStatus === 'expired') { %>
              <span class="badge badge-expired fs-6">期限切れ</span>
            <% } %>
          </dd>
          <dt class="col-5">発行日時</dt>
          <dd class="col-7"><%= coupon.created_at %></dd>
          <dt class="col-5">使用日時</dt>
          <dd class="col-7"><%= coupon.used_at || '−' %></dd>
        </dl>
        <% if (effectiveStatus === 'unused') { %>
          <form method="POST" action="/admin/coupons/<%= coupon.id %>/revoke"
                onsubmit="return confirm('このクーポンを無効化しますか？')">
            <button class="btn btn-danger btn-sm">
              <i class="bi bi-x-circle"></i> 強制無効化
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-header">キャンペーン情報</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5">キャンペーン</dt>
          <dd class="col-7"><%= coupon.campaign_name %></dd>
          <dt class="col-5">説明</dt>
          <dd class="col-7"><%= coupon.campaign_description || '−' %></dd>
          <dt class="col-5">割引</dt>
          <dd class="col-7">
            <% if (coupon.discount_value) { %>
              <strong class="text-danger">
                <%= coupon.discount_type === 'percent' ? coupon.discount_value + '%オフ' : '¥' + coupon.discount_value.toLocaleString() %>
              </strong>
            <% } else { %>−<% } %>
          </dd>
          <dt class="col-5">有効期間</dt>
          <dd class="col-7">
            <%= coupon.valid_from ? coupon.valid_from.substring(0, 10) : '−' %> 〜
            <%= coupon.valid_until ? coupon.valid_until.substring(0, 10) : '期限なし' %>
          </dd>
        </dl>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">株主情報</div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-5">氏名</dt>
          <dd class="col-7">
            <a href="/admin/shareholders/<%= coupon.shareholder_id %>"><%= coupon.shareholder_name %></a>
          </dd>
          <dt class="col-5">株主番号</dt>
          <dd class="col-7"><code><%= coupon.shareholder_number %></code></dd>
          <dt class="col-5">メール</dt>
          <dd class="col-7"><%= coupon.email || '−' %></dd>
        </dl>
      </div>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header"><i class="bi bi-link-45deg"></i> クーポンURL</div>
  <div class="card-body">
    <div class="input-group">
      <input type="text" class="form-control font-monospace"
             value="<%= baseUrl %>/coupon/<%= coupon.access_token %>"
             id="couponUrl" readonly>
      <button class="btn btn-outline-secondary" onclick="navigator.clipboard.writeText(document.getElementById('couponUrl').value)">
        <i class="bi bi-clipboard"></i> コピー
      </button>
    </div>
    <small class="text-muted">このURLを株主に送付してください</small>
  </div>
</div>

<%- include('../../partials/admin_footer') %>

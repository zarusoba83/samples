<%
  title = 'クーポン一覧';
  currentPage = 'coupons';
%>
<%- include('../../partials/admin_header') %>

<h4 class="mb-3"><i class="bi bi-ticket-perforated"></i> クーポン一覧</h4>

<% if (flash) { %>
  <div class="alert alert-<%= flash.type %> alert-dismissible">
    <%= flash.message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<form class="mb-3 d-flex gap-2 flex-wrap" method="GET">
  <select name="status" class="form-select form-select-sm" style="width:auto">
    <option value="">全ステータス</option>
    <option value="unused" <%= filters.status === 'unused' ? 'selected' : '' %>>未使用</option>
    <option value="used" <%= filters.status === 'used' ? 'selected' : '' %>>使用済み</option>
  </select>
  <button class="btn btn-sm btn-outline-secondary">フィルタ</button>
  <% if (filters.status) { %>
    <a href="/admin/coupons" class="btn btn-sm btn-outline-danger">クリア</a>
  <% } %>
</form>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-sm table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>クーポンコード</th>
          <th>株主名</th>
          <th>株主番号</th>
          <th>キャンペーン</th>
          <th>ステータス</th>
          <th>有効期限</th>
          <th>使用日時</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (rows.length === 0) { %>
          <tr><td colspan="8" class="text-center text-muted py-3">該当するクーポンがありません</td></tr>
        <% } %>
        <% rows.forEach(c => { %>
          <tr>
            <td><code><%= c.coupon_code %></code></td>
            <td><%= c.shareholder_name %></td>
            <td><small><%= c.shareholder_number %></small></td>
            <td><small><%= c.campaign_name %></small></td>
            <td>
              <% if (c.status === 'unused') { %>
                <span class="badge badge-unused">未使用</span>
              <% } else { %>
                <span class="badge badge-used">使用済み</span>
              <% } %>
            </td>
            <td><small><%= c.valid_until ? c.valid_until.substring(0, 10) : '−' %></small></td>
            <td><small><%= c.used_at || '−' %></small></td>
            <td>
              <a href="/admin/coupons/<%= c.id %>" class="btn btn-xs btn-outline-primary btn-sm">詳細</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="mt-2 text-muted small">全 <%= total %> 件</div>

<%- include('../../partials/admin_footer') %>

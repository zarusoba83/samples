<%
  title = 'キャンペーン管理';
  currentPage = 'campaigns';
%>
<%- include('../../partials/admin_header') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4><i class="bi bi-megaphone"></i> キャンペーン管理</h4>
  <a href="/admin/campaigns/new" class="btn btn-primary btn-sm">
    <i class="bi bi-plus-circle"></i> キャンペーン作成
  </a>
</div>

<% if (flash) { %>
  <div class="alert alert-<%= flash.type %> alert-dismissible">
    <%= flash.message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<% if (campaigns.length === 0) { %>
  <p class="text-muted">キャンペーンがありません</p>
<% } else { %>
  <div class="row g-3">
    <% campaigns.forEach(c => { %>
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= c.name %></h5>
            <p class="card-text text-muted small"><%= c.description || '説明なし' %></p>
            <dl class="row small mb-2">
              <dt class="col-5">割引</dt>
              <dd class="col-7">
                <% if (c.discount_value) { %>
                  <strong class="text-danger">
                    <%= c.discount_type === 'percent' ? c.discount_value + '%オフ' : '¥' + c.discount_value.toLocaleString() %>
                  </strong>
                <% } else { %>-<% } %>
              </dd>
              <dt class="col-5">有効期間</dt>
              <dd class="col-7">
                <% if (c.valid_from || c.valid_until) { %>
                  <%= c.valid_from ? c.valid_from.substring(0, 10) : '開始日未設定' %> 〜
                  <%= c.valid_until ? c.valid_until.substring(0, 10) : '期限なし' %>
                <% } else { %>期限なし<% } %>
              </dd>
              <dt class="col-5">クーポン数</dt>
              <dd class="col-7">
                <span class="badge bg-secondary"><%= c.total_coupons %></span>件
                （使用済: <span class="badge badge-used"><%= c.used_coupons || 0 %></span>）
              </dd>
            </dl>
          </div>
          <div class="card-footer d-flex gap-2">
            <form method="POST" action="/admin/campaigns/<%= c.id %>/issue">
              <button class="btn btn-sm btn-success"
                      onclick="return confirm('全株主にクーポンを発行しますか？（未発行の株主のみ対象）')">
                <i class="bi bi-send"></i> クーポン一括発行
              </button>
            </form>
            <form method="POST" action="/admin/campaigns/<%= c.id %>/delete"
                  onsubmit="return confirm('このキャンペーンと全クーポンを削除しますか？')">
              <button class="btn btn-sm btn-outline-danger">
                <i class="bi bi-trash"></i> 削除
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('../../partials/admin_footer') %>

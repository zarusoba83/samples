<%
  title = 'キャンペーン作成';
  currentPage = 'campaigns';
%>
<%- include('../../partials/admin_header') %>

<div class="d-flex align-items-center mb-3">
  <a href="/admin/campaigns" class="btn btn-sm btn-outline-secondary me-2">
    <i class="bi bi-arrow-left"></i>
  </a>
  <h4 class="mb-0"><i class="bi bi-plus-circle"></i> キャンペーン作成</h4>
</div>

<div class="card" style="max-width:560px">
  <div class="card-body">
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <form method="POST" action="/admin/campaigns">
      <div class="mb-3">
        <label class="form-label">キャンペーン名 <span class="text-danger">*</span></label>
        <input type="text" name="name" class="form-control"
               value="<%= values.name || '' %>" placeholder="例: 2025年3月期 株主優待" required>
      </div>
      <div class="mb-3">
        <label class="form-label">優待内容の説明</label>
        <textarea name="description" class="form-control" rows="3"
                  placeholder="例: 弊社オンラインショップで使えるお買い物クーポンです"><%= values.description || '' %></textarea>
      </div>
      <div class="row mb-3">
        <div class="col">
          <label class="form-label">割引タイプ</label>
          <select name="discount_type" class="form-select">
            <option value="fixed" <%= (values.discount_type || 'fixed') === 'fixed' ? 'selected' : '' %>>金額割引（円）</option>
            <option value="percent" <%= values.discount_type === 'percent' ? 'selected' : '' %>>割引率（%）</option>
          </select>
        </div>
        <div class="col">
          <label class="form-label">割引値</label>
          <input type="number" name="discount_value" class="form-control" min="0"
                 value="<%= values.discount_value || '' %>" placeholder="例: 1000">
        </div>
      </div>
      <div class="row mb-3">
        <div class="col">
          <label class="form-label">有効開始日</label>
          <input type="date" name="valid_from" class="form-control"
                 value="<%= values.valid_from || '' %>">
        </div>
        <div class="col">
          <label class="form-label">有効期限</label>
          <input type="date" name="valid_until" class="form-control"
                 value="<%= values.valid_until || '' %>">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">作成する</button>
    </form>
  </div>
</div>

<%- include('../../partials/admin_footer') %>
